# --- Database (Postgres) ---
# Any Postgres works. On Vercel, add Neon from the Marketplace and it fills this in.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/studio

# --- Anthropic (server-side only, never prefix with NEXT_PUBLIC_) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to "true" to return canned concepts instead of calling the API (tests, demos).
ANTHROPIC_MOCK=false

# --- OpenAI (images only, server-side). Powers the "Make image" button. ---
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# --- Auth (Auth.js) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Comma-separated list of team emails allowed to sign in.
ALLOWED_EMAILS=purfermeproject@gmail.com
# Option A: Google sign-in (create an OAuth client in Google Cloud Console).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Option B: email magic link via Resend (needs a verified sending domain).
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=
# Local only: skip sign-in completely (no login screen). Ignored on Vercel.
AUTH_DISABLED=false
# Local development / tests only: shows a "dev sign-in" form. Ignored on Vercel.
AUTH_DEV_LOGIN=false

# --- Storage (pack images). On Vercel, add a Blob store and it fills this in. ---
BLOB_READ_WRITE_TOKEN=
